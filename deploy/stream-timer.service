# Optional, Linux only (systemd). Edit paths/user, then:
#   sudo cp deploy/stream-timer.service /etc/systemd/system/ && sudo systemctl enable --now stream-timer
[Unit]
Description=Hyphen countdown desk
After=network-online.target
Wants=network-online.target

[Service]
User=YOU
WorkingDirectory=/home/YOU/stream-timer
Environment=BIND_HOST=127.0.0.1
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
# Stop the desk's ffmpeg children too.
KillMode=control-group

[Install]
WantedBy=multi-user.target
