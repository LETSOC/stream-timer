# Castr (or other) ingest URL. Do not commit the real value.
# RTMP_URL=rtmp://uk.castr.io/static/YOUR_STREAM?password=YOUR_PASSWORD

# Optional overrides for scripts/stream-countdown.sh
# EVENT_NAME=Hyphen Festival 2026
# EVENT_LINE=4 November 2026  •  09:30
# TARGET_UNIX=1793784600
# Optional encoder auth. If unset, a local token is created in data/encoder-token.
# ENCODER_TOKEN=
# ENCODER_ALLOW_REMOTE=1
