# Castr (or other) ingest URL. Do not commit the real value.
# RTMP_URL=rtmp://uk.castr.io/static/YOUR_STREAM?password=YOUR_PASSWORD

# Optional overrides for scripts/stream-countdown.sh
# EVENT_NAME=Hyphen Festival 2026
# EVENT_LINE=4 November 2026  •  09:30
# TARGET_UNIX=1793784600
# Optional encoder auth. If unset, a local token is created in data/encoder-token.
# ENCODER_TOKEN=
# ENCODER_ALLOW_REMOTE=1

# ---- Operator auth (see AUTH_PLAN.md) ----
# Unset on the Mac at 127.0.0.1 = local mode: no login, same as before.
# Setting a password (or BIND_HOST to a non-loopback address) switches to password mode.
# Generate with: npm run hash-password
# OPERATOR_PASSWORD_HASH=scrypt$16384$8$1$...$...
# Plain alternative for local testing only:
# OPERATOR_PASSWORD=
# Signs the session cookie. If unset, a random one is kept in data/session-secret.
# SESSION_SECRET=   # 32+ random chars: openssl rand -base64 48
# Bump to log every session out.
# SESSION_VERSION=1
# Force password mode even on loopback.
# AUTH_MODE=password
# Read-only key for OBS (/stream?k=..., /end?k=...). If unset, kept in data/view-key and rotatable from the desk.
# VIEW_KEY=
# Require the view key in local mode too.
# REQUIRE_VIEW_KEY=1
# Behind a reverse proxy: use the rightmost X-Forwarded-For hop for login throttling (never for auth).
# TRUST_PROXY=1
# Force cookie Secure flag on/off (default: on when the request is https).
# COOKIE_SECURE=1
